  "components": {
    "schemas": {
      "AddVideosRequest": {
        "properties": {
          "youtube_urls": {
            "items": {
              "type": "string",
              "maxLength": 2083,
              "minLength": 1,
              "format": "uri"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Youtube Urls"
          },
          "auto_process": {
            "type": "boolean",
            "title": "Auto Process",
            "description": "Queue a processing job for the added videos",
            "default": false
          },
          "include_visual": {
            "type": "boolean",
            "title": "Include Visual",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "youtube_urls"
        ],
        "title": "AddVideosRequest"
      },
      "AddVideosResponse": {
        "properties": {
          "signal": {
            "type": "string",
            "title": "Signal"
          },
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "added": {
            "items": {
              "$ref": "#/components/schemas/VideoOut"
            },
            "type": "array",
            "title": "Added"
          },
          "skipped": {
            "items": {
              "$ref": "#/components/schemas/SkippedUrl"
            },
            "type": "array",
            "title": "Skipped"
          },
          "job": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/JobOut"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "signal",
          "user_id",
          "added",
          "skipped"
        ],
        "title": "AddVideosResponse"
      },
      "AnswerRequest": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Query"
          },
          "limit": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 5
          },
          "mode": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SearchMode"
              },
              {
                "type": "null"
              }
            ],
            "description": "dense | sparse | hybrid"
          },
          "rerank": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rerank"
          },
          "video_ids": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Video Ids",
            "description": "Restrict search to these videos"
          },
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Language",
            "description": "Prompt language; detected when omitted"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/ChatTurn"
            },
            "type": "array",
            "maxItems": 20,
            "title": "History"
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "AnswerRequest"
      },
      "AnswerResponse": {
        "properties": {
          "signal": {
            "type": "string",
            "title": "Signal"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "language": {
            "type": "string",
            "title": "Language"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceOut"
            },
            "type": "array",
            "title": "Sources"
          }
        },
        "type": "object",
        "required": [
          "signal",
          "answer",
          "language",
          "sources"
        ],
        "title": "AnswerResponse"
      },
      "ChatTurn": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "maxLength": 8000,
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ChatTurn"
      },
      "DeleteVideoResponse": {
        "properties": {
          "signal": {
            "type": "string",
            "title": "Signal"
          },
          "video_id": {
            "type": "string",
            "title": "Video Id"
          },
          "deleted_chunks": {
            "type": "integer",
            "title": "Deleted Chunks"
          }
        },
        "type": "object",
        "required": [
          "signal",
          "video_id",
          "deleted_chunks"
        ],
        "title": "DeleteVideoResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JobOut": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "stage": {
            "$ref": "#/components/schemas/JobStage"
          },
          "progress": {
            "type": "number",
            "title": "Progress"
          },
          "current_video_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Video Id"
          },
          "video_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Video Ids"
          },
          "options": {
            "$ref": "#/components/schemas/ProcessOptions"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/JobVideoResult"
            },
            "type": "array",
            "title": "Results"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
