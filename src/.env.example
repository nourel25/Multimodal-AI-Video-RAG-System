APP_NAME="multimodal-video-rag"
APP_VERSION="2.0.0"
LOG_LEVEL="INFO"
# Leave empty to disable auth; otherwise clients must send `X-API-Key`.
API_KEY=""

# ========================= Storage =========================
MONGODB_URL="mongodb://localhost:27037"
MONGODB_DATABASE="multimodal_rag"
KEEP_MEDIA_FILES=false

# ========================= Ingestion =========================
MAX_VIDEO_DURATION_MINUTES=60
CHUNK_MAX_CHARS=800
CHUNK_OVERLAP_SEGMENTS=1

# ========================= Jobs =========================
# inline: jobs run inside the API process (no Redis). arq: separate worker via Redis.
JOB_QUEUE_BACKEND="inline"
REDIS_URL="redis://localhost:6389"

# ========================= Transcription =========================
# GROQ = hosted Whisper large-v3-turbo (fast, accurate, needs GROQ_API_KEY)
# LOCAL = faster-whisper on this machine (no key, slow on CPU)
TRANSCRIPTION_BACKEND="GROQ"
WHISPER_LOCAL_MODEL="small"
WHISPER_DEVICE="cpu"
WHISPER_COMPUTE_TYPE="int8"
GROQ_WHISPER_MODEL="whisper-large-v3-turbo"
# Used if the primary fails (e.g. Groq's daily audio quota). LOCAL loads Whisper on this machine.
TRANSCRIPTION_FALLBACK_BACKEND=""

# ========================= API keys =========================
# Free keys: https://console.groq.com/keys and https://aistudio.google.com/apikey
GROQ_API_KEY=""
GEMINI_API_KEY=""

# ========================= Generation =========================
# GROQ | GEMINI | OLLAMA. The fallback is used when the primary fails (e.g. rate limits).
# Fully offline: GENERATION_BACKEND="OLLAMA", GENERATION_FALLBACK_BACKEND="".
GENERATION_BACKEND="GROQ"
GENERATION_FALLBACK_BACKEND="GEMINI"
GENERATION_TEMPERATURE=0.1
GENERATION_MAX_TOKENS=1024
LLM_MAX_RETRIES=3

# Free tiers are limited per minute and per day. Requests are spaced to stay under these
# budgets (keep them a bit below your plan's limits; 0 disables throttling). Rate-limit
# responses are retried after the delay the provider asks for.
GROQ_REQUESTS_PER_MINUTE=25
GROQ_WHISPER_REQUESTS_PER_MINUTE=15
GEMINI_REQUESTS_PER_MINUTE=8

OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="llama3.2:1b-instruct-q8_0"
OLLAMA_VISION_MODEL="llava"

# Check which models your key can use: https://console.groq.com/docs/models
GROQ_MODEL="openai/gpt-oss-120b"
# For reasoning models (gpt-oss, qwen3); leave empty for others such as allam-2-7b.
GROQ_REASONING_EFFORT="low"
GROQ_VISION_MODEL=""

GEMINI_MODEL="gemini-3.6-flash"
GEMINI_VISION_MODEL="gemini-3.6-flash"
# Gemini 3 "thinks" first and that uses output tokens: minimal | low | medium | high.
GEMINI_THINKING_LEVEL="low"

# ========================= Vision =========================
# Captions keyframes and reads on-screen text. Empty disables the visual pipeline.
VISION_BACKEND="GEMINI"
# Each frame is one vision API call.
VISION_MAX_FRAMES=12
VISION_MAX_CONSECUTIVE_FAILURES=3
VISION_SCENE_THRESHOLD=27.0
VISION_MIN_SCENE_SECONDS=4.0

# ========================= Embeddings & retrieval =========================
EMBEDDING_MODEL="BAAI/bge-m3"
# auto = GPU when PyTorch sees one (needs the CUDA build of torch), else CPU.
EMBEDDING_DEVICE="auto"
EMBEDDING_BATCH_SIZE=16
EMBEDDING_QUERY_PREFIX=""
EMBEDDING_DOCUMENT_PREFIX=""
PRELOAD_MODELS=false

RETRIEVAL_MODE="hybrid"
RETRIEVAL_CANDIDATES=20
RERANK_ENABLED=true
RERANKER_MODEL="BAAI/bge-reranker-v2-m3"
# Drop reranked sources below this relevance (0-1). Off-topic questions then get a
# "no relevant content" reply without an LLM call. 0 disables it.
RERANK_MIN_SCORE=0.05

# ========================= Vector DB =========================
VECTOR_DB_BACKEND="QDRANT"
# Empty = embedded on-disk Qdrant under assets/database (single process only).
QDRANT_URL=""
QDRANT_API_KEY=""
VECTOR_DB_PATH="qdrant_db"
VECTOR_DB_DISTANCE_METHOD="cosine"

# ========================= Templates =========================
PRIMARY_LANG="en"
DEFAULT_LANG="en"
