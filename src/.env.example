APP_NAME="multimodal-video-rag"
APP_VERSION="2.0.0"
LOG_LEVEL="INFO"
# Leave empty to disable auth; otherwise clients must send `X-API-Key`.
API_KEY=""

# ========================= Storage =========================
MONGODB_URL="mongodb://localhost:27037"
MONGODB_DATABASE="multimodal_rag"
KEEP_MEDIA_FILES=false

# ========================= Ingestion =========================
MAX_VIDEO_DURATION_MINUTES=60
CHUNK_MAX_CHARS=800
CHUNK_OVERLAP_SEGMENTS=1

# ========================= Jobs =========================
# inline: jobs run inside the API process (no Redis). arq: separate worker via Redis.
JOB_QUEUE_BACKEND="inline"
REDIS_URL="redis://localhost:6389"

# ========================= Transcription =========================
# GROQ = hosted Whisper large-v3-turbo (fast, accurate, needs GROQ_API_KEY)
# LOCAL = faster-whisper on this machine (no key, slow on CPU)
TRANSCRIPTION_BACKEND="GROQ"
WHISPER_LOCAL_MODEL="small"
WHISPER_DEVICE="cpu"
WHISPER_COMPUTE_TYPE="int8"
GROQ_WHISPER_MODEL="whisper-large-v3-turbo"

# ========================= API keys =========================
# Free keys: https://console.groq.com/keys and https://aistudio.google.com/apikey
GROQ_API_KEY=""
GEMINI_API_KEY=""

# ========================= Generation =========================
# GROQ | GEMINI | OLLAMA. The fallback is used when the primary fails (e.g. rate limits).
# Fully offline: GENERATION_BACKEND="OLLAMA", GENERATION_FALLBACK_BACKEND="".
GENERATION_BACKEND="GROQ"
GENERATION_FALLBACK_BACKEND="GEMINI"
GENERATION_TEMPERATURE=0.1
GENERATION_MAX_TOKENS=1024
LLM_MAX_RETRIES=3

OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="llama3.2:1b-instruct-q8_0"
OLLAMA_VISION_MODEL="llava"

GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_VISION_MODEL=""

GEMINI_MODEL="gemini-3.6-flash"
GEMINI_VISION_MODEL="gemini-3.6-flash"

# ========================= Vision =========================
# Captions keyframes and reads on-screen text. Empty disables the visual pipeline.
VISION_BACKEND="GEMINI"
VISION_MAX_FRAMES=24
VISION_SCENE_THRESHOLD=27.0
VISION_MIN_SCENE_SECONDS=4.0

# ========================= Embeddings & retrieval =========================
EMBEDDING_MODEL="BAAI/bge-m3"
EMBEDDING_DEVICE="cpu"
EMBEDDING_BATCH_SIZE=16
EMBEDDING_QUERY_PREFIX=""
EMBEDDING_DOCUMENT_PREFIX=""
PRELOAD_MODELS=false

RETRIEVAL_MODE="hybrid"
RETRIEVAL_CANDIDATES=20
RERANK_ENABLED=true
RERANKER_MODEL="BAAI/bge-reranker-v2-m3"

# ========================= Vector DB =========================
VECTOR_DB_BACKEND="QDRANT"
# Empty = embedded on-disk Qdrant under assets/database (single process only).
QDRANT_URL=""
QDRANT_API_KEY=""
VECTOR_DB_PATH="qdrant_db"
VECTOR_DB_DISTANCE_METHOD="cosine"

# ========================= Templates =========================
PRIMARY_LANG="en"
DEFAULT_LANG="en"
