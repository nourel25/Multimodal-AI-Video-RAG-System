# Copy to docker/.env. Values here only affect this compose project.
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change-me

# Host ports (bound to 127.0.0.1). Change any that clash with other services.
API_PORT=8800
UI_PORT=8850
MONGO_PORT=27037
QDRANT_PORT=6343
REDIS_PORT=6389

# Ollama on the host by default; use http://ollama:11434 with `--profile local-llm`.
OLLAMA_HOST=http://host.docker.internal:11434

# Must match API_KEY in src/.env if you enable auth.
API_KEY=
